{
  "name": "sanity-plugin-webhooks-trigger",
  "version": "1.0.1",
  "description": "",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/flayks/sanity-plugin-webhooks-trigger#readme",
  "bugs": {
    "url": "https://github.com/flayks/sanity-plugin-webhooks-trigger/issues"
  },
  "license": "MIT",
  "author": "Félix Péault (Flayks) <hello@flayks.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/flayks/sanity-plugin-webhooks-trigger.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.4",
    "crypto-js": "^4.2.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^12.2.0",
    "@sanity/plugin-kit": "^10.0.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.10.1",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.5.3",
    "typescript": "^6"
  },
  "peerDependencies": {
    "react": "^19",
    "sanity": "^5 || ^6"
  },
  "overrides": {
    "oxfmt": "$oxfmt"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false
    }
  }
}
